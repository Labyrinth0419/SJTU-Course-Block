<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.labyrinth.course_block">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <application
        android:label="课程表"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- 关闭 Impeller，回退到 Skia 渲染后端。Impeller/Vulkan 在本机型上
             光栅化课程卡的模糊阴影/逐卡 layer 合成时开销过高，导致翻页掉帧
             （实测 Raster p90 ~18ms、jank 10%）；Skia 下同样代码 Raster p90
             降到 ~3ms、jank 归零。
             注：课程卡已改为单个 CustomPaint 绘制（消除逐卡 layer 合成）、文字
             阴影 blurRadius 已改为 0（消除模糊离屏 pass），逐卡分层与模糊这两个
             当年拖垮 Impeller 的根因已消除，理论上可重新启用 Impeller，但尚未在
             本机型 profile 验证，故保持 Skia 作为安全基线。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- dynamic icon service -->
        <service
            android:name="com.solusibejo.flutter_dynamic_icon_plus.FlutterDynamicIconPlusService"
            android:stopWithTask="false" />

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <!-- launcher intent so system knows this is the app entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <receiver
            android:name="com.labyrinth.course_block.widget.TodayWidgetProvider"
            android:label="@string/widget_today_label"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 为桌面小组件 ListView 提供滚动数据的 Remote Views Service -->
        <service
            android:name="com.labyrinth.course_block.widget.CourseWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- 近日课程 Widget -->
        <receiver
            android:name="com.labyrinth.course_block.widget.UpcomingWidgetProvider"
            android:label="@string/widget_upcoming_label"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>
        <service
            android:name="com.labyrinth.course_block.widget.UpcomingWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- 一周课程 Widget -->
        <receiver
            android:name="com.labyrinth.course_block.widget.WeekWidgetProvider"
            android:label="@string/widget_week_label"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <service
            android:name="com.labyrinth.course_block.widget.WeekWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- 日视图 Widget -->
        <receiver
            android:name="com.labyrinth.course_block.widget.DayWidgetProvider"
            android:label="@string/widget_day_label"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
